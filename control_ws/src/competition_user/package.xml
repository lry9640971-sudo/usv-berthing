<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>competition_user</name>
  <version>0.0.0</version>
  <description>Closed-loop mission planning and thrust control for autonomous USV berthing.</description>
  <maintainer email="292311248+lry9640971-sudo@users.noreply.github.com">lry9640971-sudo</maintainer>
  <license>NOASSERTION</license>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>phase16z_perception_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>phase17_berthing_perception</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
